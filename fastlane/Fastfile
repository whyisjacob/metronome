default_platform(:ios)

require "shellwords"
require "tmpdir"

# Fixed identity for this project.
BUNDLE_ID = "app.metronome.mobile".freeze
TEAM_ID   = "DBGYCM8364".freeze

platform :ios do
  desc "Build a signed Release archive and upload it to TestFlight.\n" \
       "Uses an App Store Connect API key with automatic, cloud-managed signing " \
       "(no manual certificates, no fastlane match)."
  lane :beta do
    # --- App Store Connect API key ---------------------------------------------
    # Used by upload_to_testflight (pilot). key_content is the full .p8 PEM text
    # from the CI secret; nothing is printed.
    key_id      = ENV.fetch("ASC_KEY_ID")
    issuer_id   = ENV.fetch("ASC_ISSUER_ID")
    key_content = ENV.fetch("ASC_KEY_P8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    # xcodebuild needs the key as a FILE so -authenticationKeyPath can use it to
    # talk to Apple during the EXPORT step (where the App Store distribution
    # certificate + provisioning profile are cloud-created). Write it OUTSIDE
    # ./build so it can never land in the uploaded artifact.
    key_dir  = ENV["RUNNER_TEMP"] || Dir.tmpdir
    key_path = File.join(key_dir, "asc_api_key.p8")
    File.write(key_path, key_content)
    File.chmod(0600, key_path)

    # This gym version has no build_app `api_key:` param — authenticate cloud
    # signing via xcodebuild's own flags instead.
    auth = "-authenticationKeyPath #{key_path.shellescape} " \
           "-authenticationKeyID #{key_id.shellescape} " \
           "-authenticationKeyIssuerID #{issuer_id.shellescape}"

    # NOTE ON APP-RECORD CREATION
    # There is deliberately no `produce` / `create_app_online` step here: that
    # action only supports Apple-ID (username + 2FA) auth, and the App Store
    # Connect API itself has NO endpoint to create an app record. So the record
    # must already exist in App Store Connect. Signing below does NOT need it
    # (it only needs the App ID, which -allowProvisioningUpdates registers), so
    # we build first (registering the bundle id + proving signing) and let the
    # upload step be the point of truth — with a precise account-holder message
    # if the record is missing.

    # --- Build number: unique + increasing, from the CI run number ------------
    build_number = ENV["BUILD_NUMBER"] || "1"

    # Absolute paths so the raw archive step below is CWD-independent.
    repo_root    = File.expand_path("..", __dir__)
    project_path = File.join(repo_root, "Metronome.xcodeproj")
    build_dir    = File.join(repo_root, "build")
    archive_path = File.join(build_dir, "Metronome.xcarchive")

    # --- Step 1: ARCHIVE (unsigned) -------------------------------------------
    # WHY unsigned: `xcodebuild archive` with automatic signing resolves an iOS
    # App *Development* provisioning profile, which Apple only issues if the team
    # has >= 1 registered device. This team has none, so a signed archive dies
    # ("no devices from which to generate a provisioning profile ... couldn't
    # find any iOS App Development profiles"). App Store *Distribution* profiles
    # need NO devices, so we skip signing here (hermetic — no Apple contact) and
    # sign for distribution at export (Step 2).
    #
    # This is a RAW xcodebuild call, NOT gym's `xcargs`, on purpose: this gym
    # version forwards `xcargs` to BOTH the archive and the -exportArchive
    # commands, so CODE_SIGNING_ALLOWED=NO would leak into export and break
    # signing there. Splitting keeps signing-disable on the archive only.
    sh(
      "xcodebuild -project #{project_path.shellescape} -scheme Metronome " \
      "-configuration Release -destination 'generic/platform=iOS' " \
      "-archivePath #{archive_path.shellescape} " \
      "CODE_SIGNING_ALLOWED=NO CURRENT_PROJECT_VERSION=#{build_number} clean archive"
    )

    # --- Step 2: EXPORT + sign for App Store distribution (cloud-managed) ------
    # gym only exports here (skip_build_archive), so `xcargs` — the API-key auth
    # + -allowProvisioningUpdates — is the ONLY thing on the -exportArchive
    # command (no CODE_SIGNING_ALLOWED leak). Xcode cloud-creates the
    # distribution certificate + App Store profile via the API key and signs the
    # .ipa; -exportArchive re-signs the unsigned archive wholesale. This also
    # registers the App ID for the bundle id as a side effect (so it appears in
    # the App Store Connect "New App" dropdown).
    build_app(
      skip_build_archive: true,
      archive_path: archive_path,
      project: project_path,
      scheme: "Metronome",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates #{auth}",
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      },
      output_directory: build_dir,
      output_name: "Metronome.ipa",
      buildlog_path: File.join(build_dir, "logs")
    )

    # --- Upload to TestFlight; don't block CI on Apple's processing -----------
    begin
      upload_to_testflight(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        skip_waiting_for_build_processing: true,
        distribute_external: false,
        notify_external_testers: false
      )
    rescue => ex
      msg = ex.message.to_s
      if msg =~ /could ?n.?t find app|find app with bundle|no suitable application|application records were found|no app with/i
        UI.user_error!(
          "The signed build was produced successfully, but there is no App Store\n" \
          "Connect app record for #{BUNDLE_ID}, so nothing could be uploaded to\n" \
          "TestFlight. The App Store Connect API key CANNOT create app records\n" \
          "(Apple exposes no API for it), and `produce` needs interactive Apple-ID\n" \
          "+ 2FA sign-in — neither is possible from headless CI.\n" \
          "\n" \
          "ONE-TIME ACCOUNT-HOLDER ACTION (in a browser, ~1 minute):\n" \
          "  1. https://appstoreconnect.apple.com  ->  My Apps  ->  (+)  ->  New App\n" \
          "  2. Platform: iOS;  Name: your choice;  Primary language: English;\n" \
          "     Bundle ID: #{BUNDLE_ID}  (this run just registered it, so it now\n" \
          "     appears in the dropdown);  SKU: #{BUNDLE_ID}\n" \
          "  3. If prompted, accept pending agreements at\n" \
          "     https://developer.apple.com/account (Membership/Agreements) and the\n" \
          "     Free Applications agreement in App Store Connect (Business).\n" \
          "Then re-run this workflow — the next build will upload to TestFlight.\n" \
          "\n" \
          "Original uploader error: #{msg}"
        )
      else
        raise ex
      end
    end
  end
end
